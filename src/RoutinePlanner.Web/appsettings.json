{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:3645",
  "RoutinePlanner": {
    "CampusDbPath": "App_Data/campus.sqlite3",
    "RoutineDbPath": "App_Data/routine.sqlite3",
    "CoursesJsonPath": "App_Data/courses.json",
    "SeedPath": "App_Data/seed/teachers.seed.json",
    "ViewRootPath": "wwwroot",
    "LogsPath": "logs",
    "GenerateRateLimit": {
      "PermitLimit": 5,
      "WindowMinutes": 1
    },
    "ParallelAttempts": 0,
    "GenerationTimeoutSeconds": 30,
    "Seed": null
  }
}
